{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:best-practices", "helpers:pinGitHubActionDigestsToSemver"],
  minimumReleaseAge: "7 days",
  // Keep transitive deps (e.g. @codemirror/state) from resolving to a stale duplicate after an update.
  postUpdateOptions: ["pnpmDedupe"],
  lockFileMaintenance: {
    enabled: true,
  },
  packageRules: [
    {
      matchUpdateTypes: ["lockFileMaintenance"],
      minimumReleaseAge: null,
    },
    {
      description: "Update Vite+ and the Vite it provides together",
      matchDepNames: ["vite", "vite-plus", "@voidzero-dev/vite-plus-core"],
      groupName: "Vite+",
      groupSlug: "vite-plus",
    },
  ],
}
