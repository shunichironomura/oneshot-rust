{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:best-practices"],
  minimumReleaseAge: "7 days",
  // Keep transitive deps (e.g. @codemirror/state) from resolving to a stale duplicate after an update.
  postUpdateOptions: ["pnpmDedupe"],
  lockFileMaintenance: {
    enabled: true,
  },
  vulnerabilityAlerts: {
    // Security fixes get their own ungrouped branch per dependency; don't let a group's
    // minimumGroupSize (e.g. Vite+) hold such a single-update branch back.
    minimumGroupSize: 1,
  },
  packageRules: [
    {
      // .github/workflows/actions.lock pins action commits; gh actions-lock strips inline digests.
      description: "Use the actions lockfile instead of inline digest pins",
      matchManagers: ["github-actions"],
      pinDigests: false,
    },
    {
      description: "Override the 3-day npm age from security:minimumReleaseAgeNpm (in config:best-practices), keeping its exemptions for other update types",
      matchDatasources: ["npm"],
      matchUpdateTypes: ["major", "minor", "patch"],
      minimumReleaseAge: "7 days",
    },
    {
      matchUpdateTypes: ["lockFileMaintenance"],
      minimumReleaseAge: null,
    },
    {
      description: "Update Vite+ and the Vite it provides (both pnpm catalog entries) together",
      matchDepNames: ["vite", "vite-plus", "@voidzero-dev/vite-plus-core"],
      groupName: "Vite+",
      groupSlug: "vite-plus",
      minimumGroupSize: 2,
    },
  ],
  customManagers: [
    {
      customType: "regex",
      description: "Track the gh-actions-lock version used to verify the actions lockfile",
      managerFilePatterns: ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      matchStrings: ["gh extension install github/gh-actions-lock --pin (?<currentValue>v[^\\s]+)"],
      depNameTemplate: "github/gh-actions-lock",
      datasourceTemplate: "github-releases",
    },
  ],
}
