{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc -b && vp build",
    "preview": "vp preview",
    "check-dist": "node scripts/check-dist.ts",
    "deploy": "vp run build:deploy && wrangler deploy",
    "fetch-toolchain": "node scripts/fetch-toolchain.ts",
    "build:deploy": "vp run fetch-toolchain && vp run build && vp run check-dist",
    "serve:dist": "vp run build && vp run check-dist && wrangler dev"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@lezer/rust": "^1.0.3",
    "diff": "^9.0.0",
    "idb": "^8.0.4",
    "lucide-preact": "^1.54.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.13.3",
    "marked": "^18.1.0",
    "smol-toml": "^1.9.1",
    "typescript": "~6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "^4.149.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.10.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.10.1"
}
