# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/).

# Toolchain assets live under a content-addressed directory and never change.
/toolchain/:id/*
  Cache-Control: public, max-age=31536000, immutable

# The manifest points to the current toolchain; always revalidate it.
/toolchain/manifest.json
  Cache-Control: no-cache

# Built JS/CSS have content hashes in their file names.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
